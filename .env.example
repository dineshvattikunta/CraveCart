# CraveCart Environment Configuration Template
# Duplicate this file to .env and adjust values for your environment.

PORT=5000
MONGO_URI=mongodb://localhost:27017/cravecart
DB_NAME=cravecart
FLASK_DEBUG=1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
